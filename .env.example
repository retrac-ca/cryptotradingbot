# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Do NOT commit `.env` — it contains secrets.
# Run `npm run dev -- setup` for an interactive way to generate it, or copy by hand.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# SIMULATION MODE (default, safe)
# ---------------------------------------------------------------------------

# paper = simulated trading only (never submits real orders). DEFAULT and SAFEST.
# live  = requires REAL_FUNDS_AT_RISK=yes AND the --confirm-live flag on every
#         invocation of `bot start`, AND the exchange adapter enabling order
#         placement. Live trading is NOT available yet: the NDAX adapter keeps
#         supportsOrderPlacement=false, so `bot start` fails closed.
TRADING_MODE=paper

# Paper (simulated) balance to start with, in the quote currency (CAD by default).
PAPER_STARTING_BALANCE=10000

# Paper execution realism (0 disables the respective effect):
# Fee fraction of notional charged on each paper fill.
PAPER_FEE_FRACTION=0.0005
# Slippage fraction applied to the reference price on each paper fill.
PAPER_SLIPPAGE_FRACTION=0.0005
# Fraction of each order that fills immediately (1 = full fills).
PAPER_FILL_FRACTION=1

# How often (seconds) the paper engine re-evaluates strategy/risk and the
# market-data candles are polled.
EVALUATE_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# STATE DIRECTORY
# ---------------------------------------------------------------------------

# Every durable runtime artifact lives under this single directory. The state
# files below, the initialization marker (.init.json), and the mutation lock
# (.mutation.lock) all resolve under STATE_DIR. Runtime state is git-ignored and
# should never be committed.
STATE_DIR=.state/

# The paper portfolio is persisted across restarts so the account is not reset.
PAPER_STATE_FILE=.state/paper-state.json

# The LIVE managed portfolio (the bot's authorized inventory on the real
# exchange) is persisted here. This MUST be a DIFFERENT file from
# PAPER_STATE_FILE. F-1 safety: paper-managed positions must never be able to
# masquerade as live-managed positions, and vice-versa. If the bot has not been
# onboarded for live yet, this file will be empty/absent and the bot treats its
# live inventory as zero (fail-closed) rather than adopting paper or exchange
# state.
LIVE_MANAGED_STATE_FILE=.state/live-managed-state.json

# The durable order ledger (every order the bot attempts, keyed by
# clientOrderId) is kept here. Used for duplicate-order prevention and
# reconciliation. See `bot trades` and `bot reconcile`.
ORDER_LEDGER_FILE=.state/order-ledger.json

# The manual-execution intents (Gate 9) are kept here. These are RETRAC's
# recommendations for an operator to execute externally, deliberately separate
# from the order ledger and from the managed portfolio accounting. See
# `bot manual`.
MANUAL_INTENT_FILE=.state/manual-intents.json

# ---------------------------------------------------------------------------
# EXCHANGE
# ---------------------------------------------------------------------------

# Values currently supported: ndax
EXCHANGE=ndax

# NDAX API credentials (https://ndax.io)
# Retail NDAX REST auth = per-request signature headers:
#   HMAC-SHA256(secret, nonce+userId+apiKey) with nonce = epoch ms.
# Public market data does NOT require credentials. Account reads use these
# headers and are gated behind ENABLE_AUTHENTICATED_READS (see docs/NDAX_API.md).
NDAX_API_KEY=
NDAX_API_SECRET=
NDAX_USER_ID=

# Account email/login — used only by GetUserAccounts to look up your account id.
# Optional: provide NDAX_ACCOUNT_ID explicitly instead.
#NDAX_USER_NAME=you@example.com
#NDAX_ACCOUNT_ID=449

# Gate for authenticated reads (safe default: false). Leave false unless you
# have verified the adapter against a live account and want balance/order reads.
ENABLE_AUTHENTICATED_READS=false

# Optional: endpoint overrides (mainly useful for testing / future sandbox).
#NDAX_REST_BASE_URL=https://api.ndax.io:8443/AP/
#NDAX_WS_URL=wss://api.ndax.io:8443/AP/

# ---------------------------------------------------------------------------
# TRADING PAIRS
# ---------------------------------------------------------------------------

# Comma-separated list of symbols. Default is BTC/CAD.
# The bot reads the exchange symbol format dynamically, but keep human-readable
# BASE/QUOTE here.
TRADING_PAIRS=BTC/CAD

# The bot's curated multi-asset UNIVERSE (Gate 5). The bot only ever considers
# these markets — it never auto-trades every market an exchange lists. Each is
# further filtered through eligibility (quote currency, valid ticks, min order,
# fees, market orders). This is the effective symbol set the engine evaluates.
UNIVERSE_MARKETS=BTC/CAD,ETH/CAD,SOL/CAD,XRP/CAD,ADA/CAD

# ---------------------------------------------------------------------------
# STRATEGY
# ---------------------------------------------------------------------------

# Which strategy to use. Currently: moving-average-crossover
STRATEGY=moving-average-crossover

# Candle timeframe for strategy execution (e.g. 1m, 5m, 15m, 1h).
TIMEFRAME=5m

# Strategy-specific parameters (moving-average crossover).
MA_FAST_PERIOD=10
MA_SLOW_PERIOD=30

# ---------------------------------------------------------------------------
# RISK (conservative defaults)
# ---------------------------------------------------------------------------

# Maximum fraction of available quote balance allocated to a single trade (0..1).
MAX_POSITION_SIZE_FRACTION=0.1

# Optional hard maximum trade amount in quote currency (CAD). 0 = no hard cap.
MAX_TRADE_AMOUNT=0

# Stop-loss and take-profit as fractions of entry price (0..1). 0 = disabled.
# NOTE (Gate 5): these are parsed for configurability but are NOT yet enforced by
# the engine. They are deliberately surfaced as inactive so we never imply a
# protection that does not exist.
STOP_LOSS_FRACTION=0.05
TAKE_PROFIT_FRACTION=0.10

# Maximum accumulated daily loss fraction of starting balance (0..1). 0 = off.
MAX_DAILY_LOSS_FRACTION=0.05

# Maximum total open-position exposure as a fraction of portfolio value (0..1).
MAX_PORTFOLIO_EXPOSURE_FRACTION=0.5

# Maximum drawdown from portfolio peak as a fraction (0..1).
MAX_DRAWDOWN_FRACTION=0.10

# Maximum acceptable age of market data (ms). Stale data causes trades to be
# rejected (fail closed). Tune relative to your timeframe / poll cadence.
MARKET_DATA_MAX_AGE_MS=60000

# Gate 4 — HYBRID market-data freshness. This is a two-dimension check:
#   1. QUOTE     — age of the exchange-reported quote time (L1 TimeStamp / L2
#                  ActionDateTime), bounded by MARKET_DATA_MAX_AGE_MS above.
#   2. TRANSPORT — age of the local observation (when we actually fetched the
#                  snapshot). A freshly-fetched snapshot can still be built on a
#                  stale quote, and a fresh quote can have been fetched long ago.
#                  Both must be fresh or the decision fails closed.
MARKET_DATA_TRANSPORT_MAX_AGE_MS=60000

# Clock-skew guard: how far a quote timestamp may be AHEAD of the local clock
# before the data is treated as unreliable. This is a future-dating guard, NOT a
# widening of MARKET_DATA_MAX_AGE_MS (the stale threshold is unchanged).
MAX_CLOCK_SKEW_MS=120000

# Maximum number of open (bot-MANAGED) positions. 0 = no limit. 0 is treated as
# "no limit"; >0 blocks opening more managed positions than this. EXTERNAL
# holdings never count toward this limit.
MAX_OPEN_POSITIONS=1

# Cooldown (seconds) after a losing trade before another trade is allowed.
COOLDOWN_AFTER_LOSS_SECONDS=3600

# ---------------------------------------------------------------------------
# SYSTEM
# ---------------------------------------------------------------------------

# Logging level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# Health/balance reconciliation interval in seconds.
RECONCILE_INTERVAL_SECONDS=60

# Kill switch. Set to "true" to immediately stop all trading.
# This is a hard stop that overrides everything.
KILL_SWITCH=false
