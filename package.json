{
  "name": "cryptotradingbot",
  "version": "0.0.1",
  "description": "Modular, exchange-agnostic cryptocurrency trading bot with strong safety controls.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "bot": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "verify:ndax": "tsx scripts/verify-ndax.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.39.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
